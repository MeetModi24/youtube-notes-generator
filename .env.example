# YouTube Notes Generator Configuration

# Required: Anthropic API Key for Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Default paths
GITHUB_REPO_PATH=/path/to/your/repo
DEFAULT_OUTPUT_DIR=learning-notes

# Optional: AI Model Configuration
# Default: claude-sonnet-4-20250514
# Options: claude-opus-4-20250514, claude-sonnet-4-20250514, claude-haiku-4-20250514
AI_MODEL=claude-sonnet-4-20250514
